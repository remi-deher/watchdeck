# Copy to .env and replace every generated secret before starting Compose.
TZ=Europe/Paris
WATCHDECK_IMAGE=mrcryllix/watchdeck:latest
POSTGRES_DB=watchdeck
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Generate this value with the command documented in README.md and docs/OPERATIONS.md.
WATCHDECK_ENCRYPTION_KEY=
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT=3600
BACKUP_RETENTION_DAYS=14
